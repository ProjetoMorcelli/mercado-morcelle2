# Variáveis de ambiente do sistema (NÃO coloque valores reais neste arquivo).
# O app lê estas variáveis do ambiente do sistema/servidor; ele não carrega
# um arquivo .env sozinho. Defina-as no terminal ou no painel do servidor.

# Chave secreta das sessões (use um texto longo e aleatório)
SECRET_KEY=

# OPCIONAL - banco PostgreSQL (ex.: Supabase).
# Se ficar vazia, o sistema usa SQLite local (arquivo back/database.db).
DATABASE_URL=

# OPCIONAL - upload de imagens na nuvem (Cloudinary).
# Se ficarem vazias, as imagens são salvas em html/static/uploads/produtos/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
